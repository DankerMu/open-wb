{
  "name": "@workbuddy/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:focus": "vitest run",
    "test:shard": "vitest run --coverage --coverage.reporter=json --coverage.thresholds.lines=0 --coverage.thresholds.functions=0 --coverage.thresholds.branches=0 --coverage.thresholds.statements=0 --reporter=default --reporter=blob",
    "test:merge": "vitest --merge-reports --coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/copy-migration-assets.mjs",
    "start": "npm run build && exec node dist/server.js"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/yauzl": "^3.4.0"
  }
}
