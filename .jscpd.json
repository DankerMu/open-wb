{
  "threshold": 3,
  "pattern": "{server,web,kbservice,converter}/**/*.{ts,tsx,py,mjs}",
  "ignore": [
    "**/node_modules/**",
    "**/coverage/**",
    "**/dist/**",
    "**/.venv/**",
    "web/src/components/ui/**",
    "web/src/components/assistant-ui/**"
  ],
  "reporters": ["consoleFull"]
}
