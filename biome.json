{
  "$schema": "https://biomejs.dev/schemas/2.0.0/schema.json",
  "files": {
    "includes": [
      "server/**",
      "web/**",
      "scripts/**",
      "converter/**",
      "vitest.shared.mjs",
      "!**/node_modules",
      "!**/coverage",
      "!**/dist"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "style": {
        "noRestrictedImports": {
          "level": "error",
          "options": {
            "paths": {
              "react-router": {
                "importNames": ["RouterProvider"],
                "message": "Import RouterProvider from \"react-router/dom\": the bare one ignores navigate({ flushSync: true }) and reopens #1543."
              }
            }
          }
        }
      },
      "suspicious": {
        "noConsole": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["web/src/components/ui/**", "web/src/components/assistant-ui/**"],
      "linter": {
        "enabled": false
      }
    }
  ]
}
