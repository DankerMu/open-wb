{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/inspect-ci-workflow.js",
        "converter/sidecar.mjs",
        "converter/healthcheck.mjs",
        ".github/scripts/ci-browser-e2e.mjs"
      ]
    },
    "server": {
      "entry": ["src/server.ts", "src/service-info.ts", "test/**/*.test.ts"],
      "project": ["src/**", "test/**"],
      "ignoreBinaries": ["mkfifo", "pgrep", "bindfs", "fusermount3"]
    },
    "web": {
      "entry": [
        "index.html",
        "src/styles.css",
        "src/lib/theme.ts",
        "test/**/*.test.ts",
        "test/**/*.test.tsx"
      ],
      "project": ["src/**", "test/**"],
      "ignore": ["src/components/ui/**", "src/components/assistant-ui/**"]
    }
  }
}
